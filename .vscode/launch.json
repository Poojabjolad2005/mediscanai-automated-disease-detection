{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MediScanAI: Dev Server (npm run dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PORT": "3000"
      }
    },
    {
      "name": "MediScanAI: Debug Server (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "env": {
        "PORT": "3000"
      }
    },
    {
      "name": "MediScanAI: Launch Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "name": "MediScanAI: Production Server (npm start)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "console": "integratedTerminal",
      "preLaunchTask": "npm: build",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000"
      }
    }
  ],
  "compounds": [
    {
      "name": "MediScanAI: Full-Stack (Server + Browser)",
      "configurations": [
        "MediScanAI: Dev Server (npm run dev)",
        "MediScanAI: Launch Chrome"
      ]
    }
  ]
}
