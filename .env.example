# GEMINI_API_KEY: Optional for local development; required for real Gemini AI API calls.
# If omitted, MediScanAI runs smoothly using the built-in diagnostic inference engine.
GEMINI_API_KEY=""

# PORT: Local development server port (default: 3000)
PORT=3000

# APP_URL: Optional host URL (defaults to http://localhost:3000 locally)
APP_URL="http://localhost:3000"
